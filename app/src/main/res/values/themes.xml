<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 标准库主题（基于 AppCompat），无 ActionBar -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- 基础颜色（对应原 Material3 的 colorPrimary 系列） -->
        <item name="colorPrimary">@color/purple_500</item> <!-- 主色调（按钮、标题栏等） -->
        <item name="colorPrimaryDark">@color/purple_200</item> <!-- 状态栏颜色（对应原 colorPrimaryContainer） -->
        <item name="android:textColorPrimary">@color/white</item> <!-- 主色调区域上的文字颜色（对应原 colorOnPrimary） -->

        <!-- 次要颜色（对应原 Material3 的 colorSecondary 系列） -->
        <item name="colorAccent">@color/teal_200</item> <!-- 强调色（输入框、复选框等） -->
        <item name="android:textColorSecondary">@color/black</item> <!-- 次要区域上的文字颜色（对应原 colorOnSecondary） -->

        <!-- 状态栏颜色设置（与 colorPrimaryDark 保持一致） -->
        <item name="android:statusBarColor">@color/purple_200</item>
    </style>
</resources>